@@ -0,0 +1,42 @@
+#pragma once
+
+#include <QJsonValue>
+#include <QNetworkAccessManager>
+#include <QStringList>
+#include <QUrl>
+#include <functional>
+
+class QNetworkReply;
+class QNetworkRequest;
+
+namespace mixxx::crate_revenant {
+
+class Client final {
+  public:
+    using JsonResult = std::function<void(QJsonValue, QString)>;
+    using AudioResult = std::function<void(QString, QString)>;
+    using AudioProgress = std::function<void(qint64, qint64)>;
+
+    explicit Client(QString dataDirectory = {});
+    bool configure(QUrl server, QByteArray token);
+    bool configured() const;
+    void sources(JsonResult done);
+    void playlists(const QString& source, JsonResult done);
+    void tracks(const QString& source, const QString& playlist, JsonResult done);
+    void search(const QString& query, JsonResult rows, JsonResult done);
+    void prepare(const QString& id,
+            const QString& format,
+            AudioProgress progress,
+            AudioResult done);
+
+  private:
+    QNetworkRequest request(const QStringList& path) const;
+    void get(const QStringList& path, JsonResult done);
+
+    QNetworkAccessManager m_network;
+    const QString m_dataDirectory;
+    QUrl m_server;
+    QByteArray m_token;
+};
+
+} // namespace mixxx::crate_revenant
diff --git a/src/library/craterevenant/craterevenantfeature.cpp b/src/library/craterevenant/craterevenantfeature.cpp
