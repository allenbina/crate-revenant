@@ -0,0 +1,196 @@
+#include "library/craterevenant/craterevenantclient.h"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QStandardPaths>
+#include <QStringList>
+#include <memory>
+#include <utility>
+
+namespace mixxx::crate_revenant {
+namespace {
+
+QString errorFor(QNetworkReply* reply) {
+    const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+    if (status == 401 || status == 403) {
+        return QStringLiteral("Check the Crate Revenant API token.");
+    }
+    if (status != 200) {
+        return status ? QStringLiteral("Crate Revenant returned HTTP %1.").arg(status)
+                      : QStringLiteral("Could not reach Crate Revenant.");
+    }
+    if (reply->error() != QNetworkReply::NoError) {
+        return QStringLiteral("The Crate Revenant request was interrupted.");
+    }
+    return {};
+}
+
+} // namespace
+
+Client::Client(QString dataDirectory)
+        : m_dataDirectory(dataDirectory.isEmpty()
+                        ? QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation)
+                        : std::move(dataDirectory)) {
+    m_network.setAutoDeleteReplies(true);
+}
+
+bool Client::configure(QUrl server, QByteArray token) {
+    if (!server.isValid() || server.host().isEmpty() ||
+            (server.scheme() != QStringLiteral("http") && server.scheme() != QStringLiteral("https")) ||
+            !server.userInfo().isEmpty() || server.hasQuery() || server.hasFragment() ||
+            token.contains('\r') || token.contains('\n')) {
+        return false;
+    }
+    auto basePath = server.path();
+    while (basePath.endsWith(QLatin1Char('/'))) {
+        basePath.chop(1);
+    }
+    server.setPath(basePath);
+    m_server = std::move(server);
+    m_token = std::move(token);
+    return true;
+}
+
+bool Client::configured() const {
+    return !m_server.isEmpty();
+}
+
+QNetworkRequest Client::request(const QStringList& path) const {
+    QUrl url = m_server;
+    QString suffix;
+    for (const auto& segment : path) {
+        suffix += QLatin1Char('/') + QString::fromLatin1(QUrl::toPercentEncoding(segment));
+    }
+    url.setPath(url.path(QUrl::FullyEncoded) + QStringLiteral("/api/v1") + suffix, QUrl::StrictMode);
+    QNetworkRequest request(url);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    request.setTransferTimeout(30000);
+    if (!m_token.isEmpty()) {
+        request.setRawHeader("Authorization", "Bearer " + m_token);
+    }
+    return request;
+}
+
+void Client::get(const QStringList& path, JsonResult done) {
+    auto* reply = m_network.get(request(path));
+    QObject::connect(reply, &QNetworkReply::finished, reply, [reply, done = std::move(done)] {
+        QString error = errorFor(reply);
+        if (!error.isEmpty()) {
+            done({}, std::move(error));
+            return;
+        }
+        const auto document = QJsonDocument::fromJson(reply->readAll());
+        if (!document.isArray()) {
+            done({}, QStringLiteral("Expected a list from Crate Revenant."));
+            return;
+        }
+        done(document.array(), {});
+    });
+}
+
+void Client::sources(JsonResult done) {
+    get({QStringLiteral("sources")}, std::move(done));
+}
+
+void Client::playlists(const QString& source, JsonResult done) {
+    get({QStringLiteral("sources"), source, QStringLiteral("playlists")}, std::move(done));
+}
+
+void Client::tracks(const QString& source, const QString& playlist, JsonResult done) {
+    get({QStringLiteral("sources"), source, QStringLiteral("playlists"), playlist, QStringLiteral("tracks")},
+            std::move(done));
+}
+
+void Client::search(const QString& query, JsonResult rows, JsonResult done) {
+    auto searchRequest = request({QStringLiteral("search")});
+    auto url = searchRequest.url();
+    url.setQuery(QStringLiteral("q=") + QString::fromLatin1(QUrl::toPercentEncoding(query)),
+            QUrl::StrictMode);
+    searchRequest.setUrl(url);
+    auto* reply = m_network.get(searchRequest);
+    auto read = [reply, rows = std::move(rows)] {
+        if (reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() != 200) {
+            return;
+        }
+        while (reply->canReadLine()) {
+            const auto document = QJsonDocument::fromJson(reply->readLine());
+            if (document.isObject()) {
+                rows(document.object(), {});
+            }
+        }
+    };
+    QObject::connect(reply, &QNetworkReply::readyRead, reply, read);
+    QObject::connect(reply, &QNetworkReply::finished, reply, [reply, read, done = std::move(done)] {
+        read();
+        done({}, errorFor(reply));
+    });
+}
+
+void Client::prepare(const QString& id,
+        const QString& format,
+        AudioProgress progress,
+        AudioResult done) {
+    static const QRegularExpression suffix(QStringLiteral("^[a-zA-Z0-9]{1,12}$"));
+    if (id.isEmpty() || !suffix.match(format).hasMatch()) {
+        done({}, QStringLiteral("The track does not have a supported file format."));
+        return;
+    }
+    if (m_dataDirectory.isEmpty() || !QDir(m_dataDirectory).mkpath(QStringLiteral("CrateRevenant"))) {
+        done({}, QStringLiteral("Could not create the Crate Revenant cache."));
+        return;
+    }
+    const QByteArray cacheIdentity = m_server.toEncoded() + '\0' + id.toUtf8();
+    const auto cacheKey = QCryptographicHash::hash(cacheIdentity, QCryptographicHash::Sha256).toHex();
+    const auto path = QDir(m_dataDirectory).filePath(QStringLiteral("CrateRevenant/") +
+            QString::fromLatin1(cacheKey) + QLatin1Char('.') + format.toLower());
+    if (QFileInfo(path).size() > 0) {
+        done(path, {});
+        return;
+    }
+    auto file = std::make_shared<QSaveFile>(path);
+    if (!file->open(QIODevice::WriteOnly)) {
+        done({}, QStringLiteral("Could not open the Crate Revenant cache file."));
+        return;
+    }
+    auto* reply = m_network.get(request({QStringLiteral("tracks"), id, QStringLiteral("audio")}));
+    auto write = [reply, file] {
+        if (reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() != 200) {
+            return;
+        }
+        const auto bytes = reply->readAll();
+        if (file->write(bytes) != bytes.size()) {
+            file->cancelWriting();
+            reply->abort();
+        }
+    };
+    QObject::connect(reply, &QNetworkReply::readyRead, reply, write);
+    QObject::connect(reply, &QNetworkReply::downloadProgress, reply, std::move(progress));
+    QObject::connect(reply, &QNetworkReply::finished, reply,
+            [reply, file, path, write, done = std::move(done)] {
+                write();
+                auto error = errorFor(reply);
+                const auto expected = reply->header(QNetworkRequest::ContentLengthHeader);
+                if (error.isEmpty() && (file->size() <= 0 ||
+                         (expected.isValid() && expected.toLongLong() != file->size()))) {
+                    error = QStringLiteral("The audio download was incomplete.");
+                }
+                if (error.isEmpty() && !file->commit()) {
+                    error = QStringLiteral("Could not save the completed audio file.");
+                }
+                if (!error.isEmpty()) {
+                    file->cancelWriting();
+                }
+                const QString completedPath = error.isEmpty() ? path : QString();
+                done(completedPath, std::move(error));
+            });
+}
+
+} // namespace mixxx::crate_revenant
